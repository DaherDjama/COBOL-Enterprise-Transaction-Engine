    IDENTIFICATION DIVISION.
    PROGRAM-ID. AIRLINE-MAIN.
    AUTHOR. DJAMA AHMED DAHER.

    ENVIRONMENT DIVISION.
    INPUT-OUTPUT SECTION.
    FILE-CONTROL.
        SELECT PASSENGER-FILE ASSIGN TO "data/FLIGHT-INPUT.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
        SELECT REPORT-FILE    ASSIGN TO "data/FLIGHT-REPORT.rpt"
               ORGANIZATION IS LINE SEQUENTIAL.

    DATA DIVISION.
    FILE SECTION.
    FD  PASSENGER-FILE.
    01  SUB-INPUT-REC            PIC X(38).

    FD  REPORT-FILE.
    01  SUB-OUTPUT-REC           PIC X(53).

    WORKING-STORAGE SECTION.
    COPY "RECORD-DEF.cpy".

    01  WS-FLAGS.
        05  WS-EOF-FLAG          PIC X(01) VALUE 'N'.
            88  END-OF-FILE                VALUE 'Y'.

    PROCEDURE DIVISION.
    0000-MAIN.
        OPEN INPUT PASSENGER-FILE
        OPEN OUTPUT REPORT-FILE

        PERFORM 1000-READ-PASSENGER

        PERFORM UNTIL END-OF-FILE
            MOVE IN-PASSENGER-NAME TO OUT-PASSENGER-NAME
            MOVE IN-LOYALTY-TIER   TO OUT-LOYALTY-TIER

            CALL "COMP-FARES" USING INPUT-RECORD OUTPUT-RECORD

            WRITE SUB-OUTPUT-REC FROM OUTPUT-RECORD
            PERFORM 1000-READ-PASSENGER
        END-PERFORM

        CLOSE PASSENGER-FILE
        CLOSE REPORT-FILE
        STOP RUN.

    1000-READ-PASSENGER.
        READ PASSENGER-FILE INTO INPUT-RECORD
            AT END MOVE 'Y' TO WS-EOF-FLAG
        END-READ.
