//DJAMAJ01 JOB (AIRLINE,ACCNT),'RUN ENGINE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//*-----------------------------------------------------------------*
//* SYSTEM   : COBOL ENTERPRISE TRANSACTION ENGINE
//* AUTHOR   : DJAMA AHMED DAHER
//* PURPOSE  : EXECUTE BATCH LOGIC TO PROCESS DAILY FLIGHT RECORDS
//*-----------------------------------------------------------------*
//STEP010  EXEC PGM=AIRLINEM
//STEPLIB  DD DSN=DAHERDJ.ENTERPRISE.LOADLIB,DISP=SHR
//*
//* INPUT DATA STREAM (THE FLAT ACCOUNTING RECORD QUEUE)
//PASSFILE DD DSN=DAHERDJ.AIRLINE.DATA.INPUT,DISP=SHR
//*
//* OUTPUT TRANSACTION AUDIT LEDGER REPORT
//REPTFILE DD DSN=DAHERDJ.AIRLINE.DATA.REPORT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,2),RLSE),
//             DCB=(RECFM=FB,LRECL=53,BLKSIZE=0)
//*
//* DIAGNOSTIC LOGGING OUTFILES
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//
